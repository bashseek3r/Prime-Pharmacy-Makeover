<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Prime Pharmacy | Your Trusted Health Partner</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-gray-50">

    <header class="bg-white shadow-sm border-b border-gray-100 py-4 px-8 flex items-center justify-between sticky top-0 z-50">
        
        <div class="flex items-center space-x-3 w-1/4">
            <div class="relative w-10 h-10 flex items-center justify-center bg-[#008B8B] rounded-lg shadow-sm">
                <div class="absolute w-6 h-1.5 bg-white rounded-full"></div>
                <div class="absolute w-1.5 h-6 bg-white rounded-full"></div>
            </div>
            <div class="flex flex-col">
                <span class="font-extrabold text-xl text-[#002B45] leading-none tracking-tight uppercase">Prime</span>
                <span class="font-medium text-[10px] text-[#008B8B] tracking-[0.15em] uppercase">Pharmacy</span>
            </div>
        </div>

        <div class="flex items-center space-x-8 w-1/2">
            <nav class="flex space-x-6 text-[13px] font-bold text-[#002B45] whitespace-nowrap">
                <a href="/shop" class="hover:text-[#008B8B] transition">SHOP</a>
                <a href="/baby-care" class="hover:text-[#008B8B] transition">BABY CARE</a>
                <a href="/chronic-meds" class="hover:text-[#B22222] transition">CHRONIC MEDS</a>
            </nav>
            
            <div class="relative w-full">
                <input type="text" placeholder="Search medications..." 
                       class="w-full bg-gray-50 border border-gray-200 rounded-full py-2 px-5 text-sm focus:ring-2 focus:ring-[#008B8B] focus:border-transparent outline-none transition-all">
                <svg class="w-4 h-4 absolute right-4 top-2.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
            </div>
        </div>

        <div class="flex items-center justify-end space-x-6 w-1/4">
            <button class="text-[#002B45] hover:text-[#008B8B] transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                </svg>
            </button>

            <button class="relative text-[#002B45] hover:text-[#008B8B] transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
                </svg>
                <span class="absolute -top-1 -right-1 bg-[#008B8B] text-white text-[9px] w-4 h-4 rounded-full flex items-center justify-center font-bold">0</span>
            </button>
        </div>
    </header>

    <main class="bg-gray-50">

        <section class="relative bg-white border-b border-gray-100 overflow-hidden">
            <div class="max-w-7xl mx-auto px-8 py-10">
                
                <div class="flex flex-col md:flex-row items-center bg-[#f0f9f9] rounded-[40px] overflow-hidden min-h-[450px] shadow-sm">
                    
                    <div class="p-10 md:p-16 md:w-1/2 space-y-6">
                        <div class="inline-flex items-center space-x-2 px-3 py-1 bg-white border border-[#008B8B]/20 rounded-full">
                            <span class="flex h-2 w-2 rounded-full bg-[#008B8B]"></span>
                            <span class="text-[10px] font-bold text-[#008B8B] tracking-widest uppercase">Fast Delivery in Abuja</span>
                        </div>
                        
                        <h1 class="text-5xl font-black text-[#002B45] leading-[1.1]">
                            Your Health, <br> 
                            <span class="text-[#008B8B]">Our Priority.</span>
                        </h1>
                        
                        <p class="text-gray-500 text-lg leading-relaxed max-w-md">
                            Get your medications delivered to your doorstep. From chronic prescriptions to daily essentials, Prime Pharmacy has you covered.
                        </p>
                        
                        <div class="flex items-center space-x-4 pt-4">
                            <a href="/shop" class="bg-[#002B45] text-white px-10 py-4 rounded-full font-bold hover:bg-[#001a2b] transition-all transform hover:scale-105 shadow-xl shadow-blue-900/20">
                                Shop Now
                            </a>
                            <a href="/consult" class="bg-white border-2 border-[#002B45] text-[#002B45] px-8 py-3.5 rounded-full font-bold hover:bg-gray-50 transition-all">
                                Consult Pharmacist
                            </a>
                        </div>
                    </div>

                    <div class="md:w-1/2 h-full bg-[#e0f2f2] flex items-center justify-center relative min-h-[450px]">
                        <div class="text-[#008B8B] opacity-10 transform -rotate-12">
                             <svg class="w-80 h-80" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c0 1.1.9-2 2-2V5c0-1.1-.9-2-2-2zm-2 10h-4v4h-2v-4H7v-2h4V7h2v4h4v2z"/>
                             </svg>
                        </div>

                        <div class="absolute bottom-12 left-10 bg-white p-5 rounded-3xl shadow-2xl flex items-center space-x-4 animate-bounce-slow">
                            <div class="w-12 h-12 bg-green-50 rounded-2xl flex items-center justify-center text-green-500">
                                <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                                </svg>
                            </div>
                            <div>
                                <p class="text-[10px] text-gray-400 font-bold uppercase tracking-tighter">Verified Pharmacy</p>
                                <p class="text-sm font-extrabold text-[#002B45]">100% Genuine Meds</p>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="flex justify-center space-x-3 mt-8">
                    <button class="w-10 h-2 bg-[#008B8B] rounded-full transition-all"></button>
                    <button class="w-2 h-2 bg-gray-300 rounded-full hover:bg-gray-400 transition-all"></button>
                    <button class="w-2 h-2 bg-gray-300 rounded-full hover:bg-gray-400 transition-all"></button>
                </div>
            </div>
        </section>

        <section id="categories" class="max-w-7xl mx-auto px-8 py-16">
            </section>

            
    </main> 

</body>
</html>

