<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Prime Pharmacy | Abuja</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>
<body class="bg-gray-50 font-sans">

    <div class="bg-[#002B45] text-white py-2 text-center text-sm font-medium">
        FAST DELIVERY IN ABUJA | PCN REGISTERED | ORDER ON WHATSAPP
    </div>

    <header class="bg-white border-b sticky top-0 z-50">
        <div class="container mx-auto px-4 flex items-center justify-between py-4">
            
            <div class="flex items-center space-x-2 w-1/5">
                <div class="text-[#008B8B] text-3xl"><i class="fas fa-plus-square"></i></div>
                <div class="font-bold text-[#002B45] leading-none uppercase">
                    MegCare<br><span class="text-xs font-medium">Pharmacy</span>
                </div>
            </div>

            <div class="w-2/5 px-4">
                <div class="relative">
                    <input type="text" placeholder="Search medications..." 
                           class="w-full border border-gray-200 rounded-full py-2 px-5 focus:outline-none focus:border-[#008B8B]">
                    <i class="fas fa-search absolute right-4 top-3 text-gray-400"></i>
                </div>
            </div>

            <nav class="flex items-center justify-end space-x-6 w-2/5 text-[#002B45] font-semibold text-sm">
                <a href="#" class="hover:text-[#008B8B]">SHOP</a>
                <a href="#" class="hover:text-[#008B8B]">BABY CARE</a>
                <a href="#" class="hover:text-[#008B8B]">CHRONIC MEDS</a>
                <div class="flex items-center space-x-4 border-l pl-4">
                    <i class="far fa-user text-lg cursor-pointer"></i>
                    <i class="fas fa-shopping-cart text-lg cursor-pointer"></i>
                </div>
            </nav>
        </div>
    </header>

    <main class="container mx-auto px-4 py-16 flex flex-col md:flex-row items-center">
        <div class="md:w-1/2 space-y-6">
            <h2 class="text-5xl font-extrabold text-[#002B45] leading-tight">
                Your Trusted Abuja Partner for All Health & Wellness Needs.
            </h2>
            <div class="flex space-x-4">
                <button class="bg-[#002B45] text-white px-8 py-3 rounded font-bold uppercase">Shop Now</button>
                <button class="bg-[#008B8B] text-white px-8 py-3 rounded font-bold uppercase">Upload Prescription</button>
            </div>
        </div>
    </main>

</body>
</html>

